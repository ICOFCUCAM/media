# ─── Core ───────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# ─── Supabase (DB / Auth / Realtime / Storage) ──────────
# Project: cineforge (ref trazlydqhfvvawcvfhpw, region us-east-1).
# Schema + RLS live in packages/db/supabase/migrations; see docs/25-supabase.md.
SUPABASE_URL=https://trazlydqhfvvawcvfhpw.supabase.co
# Publishable (browser-safe) key — gated entirely by Row-Level Security.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_kWexuVMl1AUSGUAqfJTSsg_f0qDGsqe
# Service-role key — SERVER ONLY (workers/API). Bypasses RLS. Never ship to the
# browser. Copy from the Supabase dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cineforge-assets

# ─── Postgres ───────────────────────────────────────────
# Local dev Postgres, OR the Supabase pooled connection string (workers/Prisma).
DATABASE_URL=postgresql://cineforge:cineforge@localhost:5432/cineforge

# ─── Redis (queue + cache) ──────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ─── S3 / object storage (MinIO in dev) ─────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cineforge-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
CDN_BASE_URL=http://localhost:9000/cineforge-assets

# ─── RunPod GPU workers (A40 48GB) ──────────────────────
RUNPOD_API_KEY=
WAN_GPU_URL=http://localhost:8001          # Wan 2.1 worker (primary, single)
HUNYUAN_GPU_URL=http://localhost:8002      # Hunyuan Video worker (premium, single)
# Multi-GPU cluster (docs/24 §C5): comma-separated worker URLs per model,
# round-robined. Overrides the single *_GPU_URL above when set.
WAN_GPU_URLS=
HUNYUAN_GPU_URLS=
# Or fully specify a heterogeneous cluster as JSON [{id,modelId,gpuType,baseUrl}]:
GPU_CLUSTER=
VIDEO_CONCURRENCY=4

# ─── External video provider (drop-in, docs/22) ─────────
# Set the URL+key and the model auto-registers (text + image-to-video),
# dispatchable like Wan/Hunyuan. Provider must speak the contract in docs/22.
EXTERNAL_VIDEO_API_URL=
EXTERNAL_VIDEO_API_KEY=
EXTERNAL_VIDEO_MODEL_ID=external-video      # the modelId used in shots/projects
EXTERNAL_VIDEO_MODEL_NAME=External Video
EXTERNAL_VIDEO_MAX_SEC=10
# Public/CDN base for the assets bucket, so the provider can fetch seed frames
# by URL (image-to-video). Falls back to passing the storage key if unset.
ASSET_PUBLIC_BASE_URL=

# Per-character LoRA trainer (docs/28). When set, the worker's lora-queue trains
# a LoRA from a character's reference frames and writes back loraKey/loraVersion
# (the tightest identity lock). Unset → training is skipped (seed + ref frames).
LORA_TRAINER_URL=
LORA_TRAINER_KEY=
LORA_TRAINER_STEPS=1200

# ─── AI agents (server-side; never in the browser) ──────
# Anthropic — the Director (screenplay / scene & shot plan).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8             # Director model (override optional)
# OpenAI — seed frames (GPT-image-1) + narration (TTS, voice "onyx").
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Film score (docs/11) — composed by a fal text-to-music model when FAL_KEY is
# set; one score per film, looped under the cut by the render engine.
FAL_MUSIC_MODEL=fal-ai/stable-audio
FAL_MUSIC_MAX_SEC=47
# Brand outro line (drawtext) font; the worker image ships DejaVu Sans.
OUTRO_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=onyx

# ─── Auto GPU Lifecycle Manager (docs/23) ───────────────
# Pods mode: set *_POD_ID. Serverless mode: set *_ENDPOINT_ID instead.
RUNPOD_WAN_POD_ID=
RUNPOD_WAN_ENDPOINT_ID=
RUNPOD_HUNYUAN_POD_ID=
RUNPOD_HUNYUAN_ENDPOINT_ID=
GPU_IDLE_GRACE_SEC=900                      # 15-min grace before auto-shutdown
GPU_RECONCILE_SEC=30                        # reconcile-loop cadence

# ─── Video model router (optional named providers) ──────
# The adapter layer (docs/22) is provider-agnostic; set keys here and register
# the provider to route by plan (Starter→Wan, Pro→Hunyuan, Enterprise→…).
DEFAULT_VIDEO_PROVIDER=wan
FALLBACK_VIDEO_PROVIDER=hunyuan
KLING_API_KEY=
PIKA_API_KEY=
LUMA_API_KEY=
VEO_API_KEY=

# ─── Audio (server-side) ────────────────────────────────
# Voice cloning / emotion / dubbing / localization. Narration today is OpenAI
# TTS (above); ELEVENLABS/Azure unlock cloned-voice dubbing (see Multilingual).
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
XTTS_URL=http://localhost:8010
MUSICGEN_URL=http://localhost:8011

# ─── Multilingual / localization (docs/29) ──────────────
# Translation runs on the Director model (Anthropic) above. Per-language voice
# uses OpenAI TTS by default, or ELEVENLABS_API_KEY for cloned-voice dubbing.
LOCALIZATION_LANGUAGES=en,es,fr,sw,ar,hi,pt,zh   # default offered languages
LOCALIZATION_TTS_PROVIDER=openai                 # openai | elevenlabs

# ─── Ads & licensed stock footage ───────────────────────
# Reference video for ads uses LICENSED stock or user uploads (never scraping).
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ─── Billing / payments ─────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MARKETPLACE_COMMISSION=15                         # platform % on marketplace sales

# ─── Email (transactional) ──────────────────────────────
RESEND_API_KEY=
SENDGRID_API_KEY=

# ─── Social publishing (server-side; per-provider OAuth apps) ─
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_AUTHOR_URN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=

# ─── Superadmin only (never in the creator studio) ──────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ENABLE_GPU_DASHBOARD=true
ENABLE_PROVIDER_DASHBOARD=true
ENABLE_COST_DASHBOARD=true
ENABLE_SYSTEM_CONSOLE=true

# ─── Web app (apps/web, public — exposed to the browser) ─
# Leave empty for the built-in demo Studio; set to a running API to go live.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_CDN_URL=        # optional: HLS/MP4 CDN base for the player fallback
# Supabase, exposed to the browser (Auth + Realtime + Storage reads via RLS).
NEXT_PUBLIC_SUPABASE_URL=https://trazlydqhfvvawcvfhpw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_kWexuVMl1AUSGUAqfJTSsg_f0qDGsqe
