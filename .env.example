# ─── Core ───────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# ─── Postgres ───────────────────────────────────────────
DATABASE_URL=postgresql://cineforge:cineforge@localhost:5432/cineforge

# ─── Redis (queue + cache) ──────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ─── S3 / object storage (MinIO in dev) ─────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cineforge-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
CDN_BASE_URL=http://localhost:9000/cineforge-assets

# ─── RunPod GPU workers (A40 48GB) ──────────────────────
RUNPOD_API_KEY=
WAN_GPU_URL=http://localhost:8001          # Wan 2.1 worker (primary)
HUNYUAN_GPU_URL=http://localhost:8002      # Hunyuan Video worker (premium)
VIDEO_CONCURRENCY=4

# ─── Auto GPU Lifecycle Manager (docs/23) ───────────────
# Pods mode: set *_POD_ID. Serverless mode: set *_ENDPOINT_ID instead.
RUNPOD_WAN_POD_ID=
RUNPOD_WAN_ENDPOINT_ID=
RUNPOD_HUNYUAN_POD_ID=
RUNPOD_HUNYUAN_ENDPOINT_ID=
GPU_IDLE_GRACE_SEC=900                      # 15-min grace before auto-shutdown
GPU_RECONCILE_SEC=30                        # reconcile-loop cadence

# ─── LLM (Director AI) ──────────────────────────────────
# See the claude-api skill for current model ids / structured output guidance.
ANTHROPIC_API_KEY=

# ─── Audio ──────────────────────────────────────────────
ELEVENLABS_API_KEY=
XTTS_URL=http://localhost:8010
MUSICGEN_URL=http://localhost:8011

# ─── Billing ────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
