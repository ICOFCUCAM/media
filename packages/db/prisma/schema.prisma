/// End-to-end film acceptance runs (Part 2 §81, migration 0043): the 16 checks
/// and the verdict. Append-only; project_id has no foreign key (evidence outlives the film).
model AcceptanceRun {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String?  @map("project_id") @db.Uuid
  brief      String
  targetSec  Int      @map("target_sec")
  verdict    String
  checks     Json
  masterKey  String?  @map("master_key")
  gitSha     String?  @map("git_sha")
  startedAt  DateTime @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime @default(now()) @map("finished_at") @db.Timestamptz(6)

  @@index([finishedAt(sort: Desc)])
  @@map("acceptance_runs")
}

/// W13 (0048): the Editor reviews a cut, or answers one editing request (Part 1 §21, §46).
model EditorialReview {
  id             String    @id @default(uuid()) @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  requestedBy    String?   @map("requested_by") @db.Uuid
  instruction    String?
  status         String    @default("pending")
  canonVersion   String?   @map("canon_version")
  summary        String?
  findings       Json      @default("[]")
  dropped        Json      @default("[]")
  appliedVersion String?   @map("applied_version")
  error          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  appliedAt      DateTime? @map("applied_at") @db.Timestamptz(6)

  proposals EditProposal[]

  @@index([projectId, createdAt])
  @@map("editorial_reviews")
}

/// W13 (0048): one structured edit operation proposed by the Editor, dry-run with its cost.
model EditProposal {
  id          String          @id @default(uuid()) @db.Uuid
  reviewId    String          @map("review_id") @db.Uuid
  review      EditorialReview @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  projectId   String          @map("project_id") @db.Uuid
  position    Int
  op          Json
  description String
  effect      Json            @default("{}")
  status      String          @default("proposed")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt   DateTime?       @map("decided_at") @db.Timestamptz(6)

  @@unique([reviewId, position])
  @@index([reviewId, position])
  @@map("edit_proposals")
}

/// W14 (0049): one generated sentence, served again instead of generated again (Part 4 §154). Worker only.
model SpeechCache {
  key           String    @id
  engineId      String    @map("engine_id")
  engineVersion String    @map("engine_version")
  voiceId       String?   @map("voice_id") @db.Uuid
  cloned        Boolean
  language      String
  chars         Int
  storageKey    String    @unique @map("storage_key")
  format        String
  bytes         BigInt?
  hits          Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastHitAt     DateTime? @map("last_hit_at") @db.Timestamptz(6)

  @@index([voiceId])
  @@map("speech_cache")
}

// ── The Image Engine's record (W17, 0052; Part 2 §69) ──────────────────────
model ImageGeneration {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  purpose      String
  subject      String
  provider     String
  model        String?
  seed         BigInt?
  promptSha256 String   @map("prompt_sha256")
  width        Int?
  height       Int?
  storageKey   String   @map("storage_key")
  sha256       String?
  canonDigest  String?  @map("canon_digest")
  candidate    Int?
  chosen       Boolean?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, purpose], map: "image_generations_project_idx")
  @@index([subject, purpose], map: "image_generations_subject_idx")
  @@map("image_generations")
}

/// One reference still per (place or prop, canon digest) — W17, 0052.
model WorldReference {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  kind       String
  refKey     String   @map("ref_key")
  digest     String
  storageKey String   @map("storage_key")
  provider   String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([projectId, kind, refKey, digest])
  @@map("world_references")
}

