// Cineforge — Prisma schema
// PostgreSQL. Mapped onto the Supabase database (snake_case tables/columns,
// uuid ids, Postgres enum types) so the worker/API read & write the SAME tables
// the web app uses via Supabase. See docs/02-database-schema.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Identity & billing
// ─────────────────────────────────────────────────────────────

enum Tier {
  FREE
  CREATOR
  STUDIO
  AGENCY
  ENTERPRISE

  @@map("tier")
}

enum Role {
  USER
  ADMIN

  @@map("role")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  displayName    String?  @map("display_name")
  role           Role     @default(USER)
  tier           Tier     @default(FREE)
  creditsMs      Int      @default(0) @map("credits_ms") // remaining generation budget, in GPU-ms
  stripeId       String?  @map("stripe_id")
  notifyOnFinish Boolean  @default(false) @map("notify_on_finish") // email when a production is READY/FAILED
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  projects Project[]
  apiKeys  ApiKey[]
  usage    UsageRecord[]

  @@map("users")
}

model ApiKey {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashed    String    @unique
  label     String?
  lastUsed  DateTime? @map("last_used") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────
// Project / film
// ─────────────────────────────────────────────────────────────

enum ProjectStatus {
  DRAFT
  PLANNING
  GENERATING
  RENDERING
  PAUSED
  READY
  FAILED
  REVIEW // W8b (0040): a three-pass production waiting for the owner's approval

  @@map("project_status")
}

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  prompt        String
  targetSeconds Int           @map("target_seconds")
  /// Output format chosen at create time ("480p"|"720p"|"1080p"|"4k") — docs/33.
  resolution    String        @default("720p")
  aspectRatio   String        @default("16:9") @map("aspect_ratio")
  modelId       String        @default("wan-2.1") @map("model_id")
  status        ProjectStatus @default(DRAFT)
  mode          String        @default("auto") // auto | hybrid | storyboard | script | library …
  progress      Float         @default(0)
  estimatedMs   Int?          @map("estimated_ms")
  spentMs       Int           @default(0) @map("spent_ms")
  errorMessage  String?       @map("error_message")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  screenplay  Screenplay?
  characters  Character[]
  locations   Location[]
  objects     WorldObject[]
  scenes      Scene[]
  continuity  ContinuityState[]
  film        Film?
  renderJobs  RenderJob[]
  series      Series?           @relation("SeriesProject")
  storyEvents StoryEvent[]

  // W8 (0037): a locked film locks every scene in it.
  lockedAt DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy String?   @map("locked_by") @db.Uuid

  // W8b (0040): production passes — single (straight through) or three (STORY → PREVIS → FINAL).
  // W11 (0045): what is being made — format, medium, animation style, episodes.
  kind           String        @default("film")
  medium         String        @default("live_action")
  animationStyle String?       @map("animation_style")
  episodes       Int?
  // W12 (0046): an episode production belongs to a show and has a number in it.
  seriesId       String?       @map("series_id") @db.Uuid
  showSeries     Series?       @relation("ShowEpisodes", fields: [seriesId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  episodeNumber  Int?          @map("episode_number")
  cast           ProjectCast[]
  madeEpisodes   Episode[]     @relation("EpisodeProduction")

  passMode        String    @default("single") @map("pass_mode")
  storyApprovedAt DateTime? @map("story_approved_at") @db.Timestamptz(6)
  previsStartedAt DateTime? @map("previs_started_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@map("projects")
}

// ─────────────────────────────────────────────────────────────
// Phase 3 — Episodic hierarchy
// ─────────────────────────────────────────────────────────────

model Series {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @map("project_id") @db.Uuid
  project   Project  @relation("SeriesProject", fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  synopsis  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  seasons            Season[]
  bible              ShowBible?
  episodeProductions Project[]  @relation("ShowEpisodes")

  @@map("series")
}

model Season {
  id        String   @id @default(uuid()) @db.Uuid
  seriesId  String   @map("series_id") @db.Uuid
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  number    Int
  title     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  episodes Episode[]

  @@unique([seriesId, number])
  @@map("seasons")
}

model Episode {
  id        String   @id @default(uuid()) @db.Uuid
  seasonId  String   @map("season_id") @db.Uuid
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  synopsis  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// W12 (0046): the production that made this episode.
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation("EpisodeProduction", fields: [projectId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  scenes Scene[]

  @@unique([seasonId, number])
  @@index([projectId])
  @@map("episodes")
}

model StoryEvent {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeIndex Int?     @map("episode_index")
  sceneIndex   Int?     @map("scene_index")
  kind         String
  summary      String
  payload      Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, episodeIndex, sceneIndex])
  @@map("story_events")
}

// ─────────────────────────────────────────────────────────────
// Screenplay (Director AI output)
// ─────────────────────────────────────────────────────────────

model Screenplay {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logline   String
  synopsis  String
  genre     String?
  tone      String?
  acts      Json
  raw       Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("screenplays")
}

// ─────────────────────────────────────────────────────────────
// Character Bible
// ─────────────────────────────────────────────────────────────

model Character {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  age           Int?
  gender        String?
  ethnicity     String?
  appearance    String
  personality   String?
  voiceProfile  Json?    @map("voice_profile")
  arc           String?
  referenceUrls String[] @map("reference_urls")
  loraKey       String?  @map("lora_key")
  loraVersion   String?  @map("lora_version")
  /// Content hash of the LoRA artifact (migration 0027; authz v2). Server-written only.
  loraSha256    String?  @map("lora_sha256")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // W12 (0046): Character Card fields, and the card a production's character was cast from.
  heightCm          Int?          @map("height_cm")
  hair              String?
  eyes              String?
  clothing          String?
  animationStyle    String?       @map("animation_style")
  design            Json?
  sourceCharacterId String?       @map("source_character_id") @db.Uuid
  sourceCharacter   Character?    @relation("CastFromCard", fields: [sourceCharacterId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  castCopies        Character[]   @relation("CastFromCard")
  castIn            ProjectCast[]

  wardrobes     Wardrobe[]
  relationships Relationship[]   @relation("fromChar")
  related       Relationship[]   @relation("toChar")
  sceneRoles    SceneCharacter[]

  @@index([projectId])
  @@index([sourceCharacterId])
  @@map("characters")
}

/// W12 (0046): Character Cards cast into a production ("Use character").
model ProjectCast {
  projectId   String    @map("project_id") @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([projectId, characterId])
  @@index([characterId])
  @@map("project_cast")
}

/// W12 (0046): a show's bible (Part 5 §184).
model ShowBible {
  seriesId        String   @id @map("series_id") @db.Uuid
  series          Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  genre           String?
  audience        String?
  worldRules      String?  @map("world_rules")
  locations       String?
  musicIdentity   String?  @map("music_identity")
  narrativeRules  String?  @map("narrative_rules")
  episodeFormat   String?  @map("episode_format")
  continuityRules String?  @map("continuity_rules")
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("show_bibles")
}

model Wardrobe {
  id             String    @id @default(uuid()) @db.Uuid
  characterId    String    @map("character_id") @db.Uuid
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  label          String
  description    String
  validFromScene Int?      @map("valid_from_scene")
  validToScene   Int?      @map("valid_to_scene")

  @@index([characterId])
  @@map("wardrobes")
}

model Relationship {
  id     String    @id @default(uuid()) @db.Uuid
  fromId String    @map("from_id") @db.Uuid
  toId   String    @map("to_id") @db.Uuid
  from   Character @relation("fromChar", fields: [fromId], references: [id], onDelete: Cascade)
  to     Character @relation("toChar", fields: [toId], references: [id], onDelete: Cascade)
  kind   String

  @@unique([fromId, toId, kind])
  @@map("relationships")
}

// ─────────────────────────────────────────────────────────────
// World Bible
// ─────────────────────────────────────────────────────────────

enum LocationKind {
  CITY
  KINGDOM
  BUILDING
  ROOM
  LANDSCAPE
  INTERIOR
  EXTERIOR

  @@map("location_kind")
}

model Location {
  id            String       @id @default(uuid()) @db.Uuid
  projectId     String       @map("project_id") @db.Uuid
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  kind          LocationKind
  description   String
  parentId      String?      @map("parent_id") @db.Uuid
  parent        Location?    @relation("loc", fields: [parentId], references: [id])
  children      Location[]   @relation("loc")
  referenceUrls String[]     @map("reference_urls")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  scenes Scene[]

  @@index([projectId])
  @@map("locations")
}

model WorldObject {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  description   String
  referenceUrls String[] @map("reference_urls")
  category      String   @default("object")

  @@index([projectId])
  @@map("world_objects")
}

// ─────────────────────────────────────────────────────────────
// Scenes & shots
// ─────────────────────────────────────────────────────────────

enum SceneStatus {
  PENDING
  PROMPTING
  GENERATING
  AUDIO
  QC
  READY
  FAILED

  @@map("scene_status")
}

model Scene {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  index       Int
  locationId  String?     @map("location_id") @db.Uuid
  location    Location?   @relation(fields: [locationId], references: [id])
  heading     String
  summary     String
  episodeId   String?     @map("episode_id") @db.Uuid
  episode     Episode?    @relation(fields: [episodeId], references: [id])
  timeOfDay   String?     @map("time_of_day")
  weather     String?
  status      SceneStatus @default(PENDING)
  durationSec Float       @default(0) @map("duration_sec")

  // Continuity Engine (docs/28)
  dialogue        String?
  narration       String?
  camera          String?
  mood            String?
  music           String?
  characterRef    String? @map("character_ref")
  worldRef        String? @map("world_ref")
  locationNote    String? @map("location_note")
  bridge          Json?
  statePatch      Json?   @map("state_patch")
  subtitles       Json?
  dependsOn       Int[]   @default([]) @map("depends_on")
  continuityScore Int?    @map("continuity_score")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  shots         Shot[]
  characters    SceneCharacter[]
  dialogueLines DialogueLine[]
  audioTracks   AudioTrack[]

  // W8 (0037): a locked scene is frozen in the database until unlocked.
  lockedAt DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy String?   @map("locked_by") @db.Uuid

  // W8b (0040): a three-pass scene generates video only once its storyboard is approved.
  storyboardApprovedAt DateTime? @map("storyboard_approved_at") @db.Timestamptz(6)

  @@unique([projectId, index])
  @@index([projectId, status])
  @@map("scenes")
}

model SceneCharacter {
  id          String    @id @default(uuid()) @db.Uuid
  sceneId     String    @map("scene_id") @db.Uuid
  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  wardrobeId  String?   @map("wardrobe_id") @db.Uuid

  @@unique([sceneId, characterId])
  @@map("scene_characters")
}

enum ShotStatus {
  PENDING
  QUEUED
  GENERATING
  UPLOADED
  QC_PASS
  QC_FAIL
  READY
  FAILED

  @@map("shot_status")
}

model Shot {
  id                String     @id @default(uuid()) @db.Uuid
  sceneId           String     @map("scene_id") @db.Uuid
  scene             Scene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  index             Int
  prompt            String
  negativePrompt    String?    @map("negative_prompt")
  source            String     @default("text")
  seedImageKey      String?    @map("seed_image_key")
  referenceVideoKey String?    @map("reference_video_key")
  cameraType        String?    @map("camera_type")
  cameraMovement    String?    @map("camera_movement")
  cameraPlan        Json?      @map("camera_plan")
  seed              BigInt?
  durationSec       Float      @default(5) @map("duration_sec")
  modelId           String     @default("wan-2.1") @map("model_id")
  modelVersion      String?    @map("model_version")
  promptHash        String?    @map("prompt_hash")
  cacheKey          String?    @map("cache_key")
  status            ShotStatus @default(PENDING)
  videoKey          String?    @map("video_key")
  thumbnailKey      String?    @map("thumbnail_key")
  qcScore           Float?     @map("qc_score")
  /// W13 (0048): the editor's cut length; the render trims the clip to it.
  cutSec            Decimal?   @map("cut_sec") @db.Decimal(6, 3)
  gpuMs             Int?       @map("gpu_ms")
  attempts          Int        @default(0)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([sceneId, index])
  @@index([status])
  @@index([cacheKey])
  @@map("shots")
}

model DialogueLine {
  id          String  @id @default(uuid()) @db.Uuid
  sceneId     String  @map("scene_id") @db.Uuid
  scene       Scene   @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  index       Int
  characterId String? @map("character_id") @db.Uuid
  text        String
  emotion     String?
  audioKey    String? @map("audio_key")
  startMs     Int?    @map("start_ms")

  @@index([sceneId])
  @@map("dialogue_lines")
}

enum AudioKind {
  VOICE
  MUSIC
  SFX
  AMBIENCE

  @@map("audio_kind")
}

model AudioTrack {
  id         String    @id @default(uuid()) @db.Uuid
  sceneId    String    @map("scene_id") @db.Uuid
  scene      Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  kind       AudioKind
  key        String
  startMs    Int       @default(0) @map("start_ms")
  durationMs Int?      @map("duration_ms")
  gainDb     Float     @default(0) @map("gain_db")
  meta       Json?

  @@index([sceneId, kind])
  @@map("audio_tracks")
}

// ─────────────────────────────────────────────────────────────
// Continuity Engine
// ─────────────────────────────────────────────────────────────

model ContinuityState {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneIndex Int      @map("scene_index")
  state      Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([projectId, sceneIndex])
  @@index([projectId])
  @@map("continuity_states")
}

// ─────────────────────────────────────────────────────────────
// Film & rendering
// ─────────────────────────────────────────────────────────────

enum RenderStatus {
  QUEUED
  ASSEMBLING
  TRANSCODING
  DONE
  FAILED

  @@map("render_status")
}

model RenderJob {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @map("project_id") @db.Uuid
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String       @default("final")
  status    RenderStatus @default(QUEUED)
  progress  Float        @default(0)
  outputKey String?      @map("output_key")
  log       String?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, status])
  @@map("render_jobs")
}

model Film {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @unique @map("project_id") @db.Uuid
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mp4Key       String    @map("mp4_key")
  hlsKey       String?   @map("hls_key")
  posterKey    String?   @map("poster_key")
  durationSec  Float     @map("duration_sec")
  subtitleKey  String?   @map("subtitle_key")
  sizeBytes    BigInt?   @map("size_bytes")
  version      Int       @default(1)
  views        Int       @default(0)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(6)
  publications Json?
  // Per-language variants (docs/29 dubbing): locales[lang] = { mp4, voice, subtitle }
  locales      Json?
  /// 4K upscaled master (Studio+; fal upscaler) — docs/33.
  mp44kKey     String?   @map("mp4_4k_key")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("films")
}

// ─────────────────────────────────────────────────────────────
// Usage / quotas
// ─────────────────────────────────────────────────────────────

model UsageRecord {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?  @map("project_id") @db.Uuid
  gpuMs     Int      @default(0) @map("gpu_ms")
  /// video | llm | tts | image | music | moderation (0044)
  kind      String
  costUsd   Float    @default(0) @map("cost_usd")
  provider  String?
  model     String?
  /// gpu_ms | tokens | characters | images | audio_seconds | requests
  unit      String?
  units     Decimal  @default(0) @db.Decimal(16, 3)
  /// Credits charged for this call (0 until a METER_RATES rate is set).
  creditMs  BigInt   @default(0) @map("credit_ms")
  meta      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("usage_records")
}

/// Stripe events already applied (0044): a replayed webhook changes nothing.
model StripeEvent {
  id        String   @id
  type      String
  userId    String?  @map("user_id") @db.Uuid
  creditMs  BigInt   @default(0) @map("credit_ms")
  tier      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("stripe_events")
}

// ── Voice Lab (docs/29 phase 2): cloned voices + long-form voiceovers ──────
model Voice {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @map("user_id") @db.Uuid
  name               String
  sampleKey          String?     @map("sample_key")
  provider           String?
  providerVoiceId    String?     @map("provider_voice_id")
  status             String      @default("PENDING")
  shareStatus        String      @default("PRIVATE") @map("share_status")
  shareTerms         String?     @map("share_terms")
  errorMessage       String?     @map("error_message")
  // W7 (0036): consent is recorded with every voice; enrollment refuses none.
  consentType        String?     @map("consent_type")
  consentConfirmedAt DateTime?   @map("consent_confirmed_at") @db.Timestamptz(6)
  language           String?
  quality            Json?
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  voiceovers         Voiceover[]

  @@map("voices")
}

// ── Per-use licences to community voices (W15, 0050; Part 4 §170) ───────────
model VoiceLicence {
  id         String    @id @default(uuid()) @db.Uuid
  voiceId    String    @map("voice_id") @db.Uuid
  licenseeId String    @map("licensee_id") @db.Uuid
  terms      String    @default("")
  acceptedAt DateTime  @default(now()) @map("accepted_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@unique([voiceId, licenseeId])
  @@index([licenseeId], map: "voice_licences_licensee_idx")
  @@map("voice_licences")
}

// ── Voice Engine (W7, 0036): engine artifacts + jobs with eight states ─────
model VoiceEngineArtifact {
  id            String   @id @default(uuid()) @db.Uuid
  voiceId       String   @map("voice_id") @db.Uuid
  engineId      String   @map("engine_id")
  engineVersion String   @map("engine_version")
  artifactType  String   @map("artifact_type")
  artifactUri   String   @map("artifact_uri")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([voiceId, engineId, engineVersion])
  @@map("voice_engine_artifacts")
}

model VoiceJob {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  voiceId     String?   @map("voice_id") @db.Uuid
  type        String
  engine      String?
  status      String    @default("queued")
  payload     Json      @default("{}")
  result      Json?
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([status])
  @@map("voice_jobs")
}

model Voiceover {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  voiceId      String?  @map("voice_id") @db.Uuid
  voice        Voice?   @relation(fields: [voiceId], references: [id], onDelete: SetNull)
  title        String
  text         String
  language     String   @default("en")
  audioKey     String?  @map("audio_key")
  status       String   @default("PENDING")
  errorMessage String?  @map("error_message")
  // W15 (0050): how the reading is spoken, and what was delivered.
  mode         String   @default("narrator")
  style        Json     @default("{}")
  speakers     Json     @default("[]")
  engine       String?
  durationMs   Int?     @map("duration_ms")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("voiceovers")
}

