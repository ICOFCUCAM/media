// ─────────────────────────────────────────────────────────────
// Truth layer (migration 0031; DirectorOS W1 — DOS-73/75/77/78)
// ─────────────────────────────────────────────────────────────

/// A gap a production ran with (append-only). Failures stop the job instead.
model ProductionDegradation {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  code      String
  severity  String
  scope     String
  refId     String?  @map("ref_id")
  message   String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, createdAt], map: "production_degradations_project_idx")
  @@map("production_degradations")
}

/// What is actually operational now, computed by the worker (never hand-written).
model SystemCapability {
  capability    String   @id
  provider      String?
  status        String
  realExecution Boolean  @map("real_execution")
  requiresGpu   Boolean  @default(false) @map("requires_gpu")
  supports      String[] @default([])
  note          String?
  reportedBy    String   @map("reported_by")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("system_capabilities")
}

/// One call to a reasoning model (migration 0032; DOS-48/49). Append-only.
model AiDecision {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String?  @map("project_id") @db.Uuid
  task          String
  promptId      String   @map("prompt_id")
  promptVersion Int      @map("prompt_version")
  schemaName    String   @map("schema_name")
  provider      String?
  model         String?
  attempt       Int      @default(0)
  inputSha256   String   @map("input_sha256")
  outputSha256  String?  @map("output_sha256")
  outcome       String
  errorCode     String?  @map("error_code")
  issues        Int      @default(0)
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  latencyMs     Int?     @map("latency_ms")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // W9 (0042): the "why" of the decision, in a sentence.
  summary String?

  @@index([projectId, createdAt], map: "ai_decisions_project_idx")
  @@index([task, createdAt], map: "ai_decisions_task_idx")
  @@map("ai_decisions")
}

/// Canon revisions (DirectorOS W3, migration 0033): append-only log of canon
