// ── Media Runtime Gateway (docs/39; migration 0026) ─────────────────────────
// Registry of GPU deployments and the execution audit trail. Written only by
// the worker; admins read. Grant identity columns and events are immutable
// (database triggers).

model RuntimeDeployment {
  id            String   @id
  modelId       String   @map("model_id")
  baseUrl       String   @unique @map("base_url")
  runpodPodId   String?  @map("runpod_pod_id")
  status        String   @default("pending")
  enforcement   String   @default("report")
  manifest      Json?
  approvedImage String?  @map("approved_image")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  grants RuntimeExecutionGrant[]

  @@map("runtime_deployments")
}

model RuntimeExecutionGrant {
  id           String             @id
  jti          String?            @unique
  deploymentId String?            @map("deployment_id")
  deployment   RuntimeDeployment? @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  shotId       String?            @map("shot_id") @db.Uuid
  projectId    String?            @map("project_id") @db.Uuid
  scope        String
  mode         String
  authzDigest  String?            @map("authz_digest")
  bodySha256   String?            @map("body_sha256")
  inputKeys    String[]           @default([]) @map("input_keys")
  outputKeys   String[]           @default([]) @map("output_keys")
  imageRef     String?            @map("image_ref")
  issuedAt     DateTime           @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt    DateTime?          @map("expires_at") @db.Timestamptz(6)
  outcome      String
  errorCode    String?            @map("error_code")
  gpuMs        Int?               @map("gpu_ms")
  outputBytes  BigInt?            @map("output_bytes")
  completedAt  DateTime?          @map("completed_at") @db.Timestamptz(6)

  @@index([shotId], map: "runtime_execution_grants_shot_idx")
  @@index([deploymentId, issuedAt(sort: Desc)], map: "runtime_execution_grants_deployment_idx")
  @@map("runtime_execution_grants")
}

model RuntimeGatewayEvent {
  id           String   @id @default(uuid()) @db.Uuid
  type         String
  deploymentId String?  @map("deployment_id")
  grantId      String?  @map("grant_id")
  code         String?
  detail       Json     @default("{}")
  actor        String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([deploymentId, createdAt(sort: Desc)], map: "runtime_gateway_events_deployment_idx")
  @@map("runtime_gateway_events")
}

// ─────────────────────────────────────────────────────────────
// Master Production Clock, generation ledgers and A/V sync
// (migrations 0028–0030; docs/38 §AU.16, §AV.5, §AW.9). Times are
// integer microseconds (BigInt); rates are fpsNum/fpsDen. Scalar foreign
// keys only: the database enforces the relations, immutability and RLS.
// ─────────────────────────────────────────────────────────────

model ProductionTimeline {
  id                String    @id @default(uuid()) @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  version           Int
  parentVersionId   String?   @map("parent_version_id") @db.Uuid
  fpsNum            Int       @map("fps_num")
  fpsDen            Int       @map("fps_den")
  sampleRate        Int       @default(48000) @map("sample_rate")
  durationUs        BigInt    @default(0) @map("duration_us")
  status            String    @default("draft")
  syncPolicyId      String    @default("cinematic") @map("sync_policy_id")
  syncPolicyVersion Int       @default(1) @map("sync_policy_version")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz(6)

  @@unique([projectId, version])
  @@index([projectId, version(sort: Desc)], map: "production_timelines_project_idx")
  @@map("production_timelines")
}

model TimelineEvent {
  id                String   @id @default(uuid()) @db.Uuid
  timelineVersionId String   @map("timeline_version_id") @db.Uuid
  kind              String
  startUs           BigInt   @map("start_us")
  endUs             BigInt   @map("end_us")
  refType           String?  @map("ref_type")
  refId             String?  @map("ref_id") @db.Uuid
  parentEventId     String?  @map("parent_event_id") @db.Uuid
  anchorEventId     String?  @map("anchor_event_id") @db.Uuid
  anchorOffsetUs    BigInt?  @map("anchor_offset_us")
  anchorMode        String?  @map("anchor_mode")
  payload           Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([timelineVersionId, startUs], map: "timeline_events_timeline_idx")
  @@index([refType, refId], map: "timeline_events_ref_idx")
  @@map("timeline_events")
}

model MediaVersion {
