  invalidated    Int      @default(0)
  actor          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, createdAt], map: "canon_revisions_project_idx")
  @@map("canon_revisions")
}

/// Wardrobe reference pack (migration 0034): one still per character,
