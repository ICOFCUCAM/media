// Cineforge — Prisma schema
// PostgreSQL. Mapped onto the Supabase database (snake_case tables/columns,
// uuid ids, Postgres enum types) so the worker/API read & write the SAME tables
// the web app uses via Supabase. See docs/02-database-schema.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Identity & billing
// ─────────────────────────────────────────────────────────────

enum Tier {
  FREE
  CREATOR
  STUDIO
  ENTERPRISE

  @@map("tier")
}

enum Role {
  USER
  ADMIN

  @@map("role")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String?  @map("display_name")
  role        Role     @default(USER)
  tier        Tier     @default(FREE)
  creditsMs   Int      @default(0) @map("credits_ms") // remaining generation budget, in GPU-ms
  stripeId    String?  @map("stripe_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  projects Project[]
  apiKeys  ApiKey[]
  usage    UsageRecord[]

  @@map("users")
}

model ApiKey {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashed    String    @unique
  label     String?
  lastUsed  DateTime? @map("last_used") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────
// Project / film
// ─────────────────────────────────────────────────────────────

enum ProjectStatus {
  DRAFT
  PLANNING
  GENERATING
  RENDERING
  PAUSED
  READY
  FAILED

  @@map("project_status")
}

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  prompt        String
  targetSeconds Int           @map("target_seconds")
  aspectRatio   String        @default("16:9") @map("aspect_ratio")
  modelId       String        @default("wan-2.1") @map("model_id")
  status        ProjectStatus @default(DRAFT)
  mode          String        @default("auto") // auto | hybrid | storyboard | script | library …
  progress      Float         @default(0)
  estimatedMs   Int?          @map("estimated_ms")
  spentMs       Int           @default(0) @map("spent_ms")
  errorMessage  String?       @map("error_message")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  screenplay  Screenplay?
  characters  Character[]
  locations   Location[]
  objects     WorldObject[]
  scenes      Scene[]
  continuity  ContinuityState[]
  film        Film?
  renderJobs  RenderJob[]
  series      Series?
  storyEvents StoryEvent[]

  @@index([userId, status])
  @@map("projects")
}

// ─────────────────────────────────────────────────────────────
// Phase 3 — Episodic hierarchy
// ─────────────────────────────────────────────────────────────

model Series {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  synopsis  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  seasons Season[]

  @@map("series")
}

model Season {
  id        String   @id @default(uuid()) @db.Uuid
  seriesId  String   @map("series_id") @db.Uuid
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  number    Int
  title     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  episodes Episode[]

  @@unique([seriesId, number])
  @@map("seasons")
}

model Episode {
  id        String   @id @default(uuid()) @db.Uuid
  seasonId  String   @map("season_id") @db.Uuid
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  synopsis  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  scenes Scene[]

  @@unique([seasonId, number])
  @@map("episodes")
}

model StoryEvent {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeIndex Int?     @map("episode_index")
  sceneIndex   Int?     @map("scene_index")
  kind         String
  summary      String
  payload      Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, episodeIndex, sceneIndex])
  @@map("story_events")
}

// ─────────────────────────────────────────────────────────────
// Screenplay (Director AI output)
// ─────────────────────────────────────────────────────────────

model Screenplay {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logline   String
  synopsis  String
  genre     String?
  tone      String?
  acts      Json
  raw       Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("screenplays")
}

// ─────────────────────────────────────────────────────────────
// Character Bible
// ─────────────────────────────────────────────────────────────

model Character {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  age           Int?
  gender        String?
  ethnicity     String?
  appearance    String
  personality   String?
  voiceProfile  Json?    @map("voice_profile")
  arc           String?
  referenceUrls String[] @map("reference_urls")
  loraKey       String?  @map("lora_key")
  loraVersion   String?  @map("lora_version")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  wardrobes     Wardrobe[]
  relationships Relationship[]   @relation("fromChar")
  related       Relationship[]   @relation("toChar")
  sceneRoles    SceneCharacter[]

  @@index([projectId])
  @@map("characters")
}

model Wardrobe {
  id             String    @id @default(uuid()) @db.Uuid
  characterId    String    @map("character_id") @db.Uuid
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  label          String
  description    String
  validFromScene Int?      @map("valid_from_scene")
  validToScene   Int?      @map("valid_to_scene")

  @@index([characterId])
  @@map("wardrobes")
}

model Relationship {
  id     String    @id @default(uuid()) @db.Uuid
  fromId String    @map("from_id") @db.Uuid
  toId   String    @map("to_id") @db.Uuid
  from   Character @relation("fromChar", fields: [fromId], references: [id], onDelete: Cascade)
  to     Character @relation("toChar", fields: [toId], references: [id], onDelete: Cascade)
  kind   String

  @@unique([fromId, toId, kind])
  @@map("relationships")
}

// ─────────────────────────────────────────────────────────────
// World Bible
// ─────────────────────────────────────────────────────────────

enum LocationKind {
  CITY
  KINGDOM
  BUILDING
  ROOM
  LANDSCAPE
  INTERIOR
  EXTERIOR

  @@map("location_kind")
}

model Location {
  id            String       @id @default(uuid()) @db.Uuid
  projectId     String       @map("project_id") @db.Uuid
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  kind          LocationKind
  description   String
  parentId      String?      @map("parent_id") @db.Uuid
  parent        Location?    @relation("loc", fields: [parentId], references: [id])
  children      Location[]   @relation("loc")
  referenceUrls String[]     @map("reference_urls")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  scenes Scene[]

  @@index([projectId])
  @@map("locations")
}

model WorldObject {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  description   String
  referenceUrls String[] @map("reference_urls")
  category      String   @default("object")

  @@index([projectId])
  @@map("world_objects")
}

// ─────────────────────────────────────────────────────────────
// Scenes & shots
// ─────────────────────────────────────────────────────────────

enum SceneStatus {
  PENDING
  PROMPTING
  GENERATING
  AUDIO
  QC
  READY
  FAILED

  @@map("scene_status")
}

model Scene {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  index       Int
  locationId  String?     @map("location_id") @db.Uuid
  location    Location?   @relation(fields: [locationId], references: [id])
  heading     String
  summary     String
  episodeId   String?     @map("episode_id") @db.Uuid
  episode     Episode?    @relation(fields: [episodeId], references: [id])
  timeOfDay   String?     @map("time_of_day")
  weather     String?
  status      SceneStatus @default(PENDING)
  durationSec Float       @default(0) @map("duration_sec")

  // Continuity Engine (docs/28)
  dialogue        String?
  narration       String?
  camera          String?
  mood            String?
  music           String?
  characterRef    String? @map("character_ref")
  worldRef        String? @map("world_ref")
  locationNote    String? @map("location_note")
  bridge          Json?
  statePatch      Json?   @map("state_patch")
  subtitles       Json?
  dependsOn       Int[]   @default([]) @map("depends_on")
  continuityScore Int?    @map("continuity_score")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  shots       Shot[]
  characters  SceneCharacter[]
  dialogueLines DialogueLine[]
  audioTracks AudioTrack[]

  @@unique([projectId, index])
  @@index([projectId, status])
  @@map("scenes")
}

model SceneCharacter {
  id          String    @id @default(uuid()) @db.Uuid
  sceneId     String    @map("scene_id") @db.Uuid
  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  wardrobeId  String?   @map("wardrobe_id") @db.Uuid

  @@unique([sceneId, characterId])
  @@map("scene_characters")
}

enum ShotStatus {
  PENDING
  QUEUED
  GENERATING
  UPLOADED
  QC_PASS
  QC_FAIL
  READY
  FAILED

  @@map("shot_status")
}

model Shot {
  id                String     @id @default(uuid()) @db.Uuid
  sceneId           String     @map("scene_id") @db.Uuid
  scene             Scene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  index             Int
  prompt            String
  negativePrompt    String?    @map("negative_prompt")
  source            String     @default("text")
  seedImageKey      String?    @map("seed_image_key")
  referenceVideoKey String?    @map("reference_video_key")
  cameraType        String?    @map("camera_type")
  cameraMovement    String?    @map("camera_movement")
  cameraPlan        Json?      @map("camera_plan")
  seed              BigInt?
  durationSec       Float      @default(5) @map("duration_sec")
  modelId           String     @default("wan-2.1") @map("model_id")
  modelVersion      String?    @map("model_version")
  promptHash        String?    @map("prompt_hash")
  cacheKey          String?    @map("cache_key")
  status            ShotStatus @default(PENDING)
  videoKey          String?    @map("video_key")
  thumbnailKey      String?    @map("thumbnail_key")
  qcScore           Float?     @map("qc_score")
  gpuMs             Int?       @map("gpu_ms")
  attempts          Int        @default(0)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([sceneId, index])
  @@index([status])
  @@index([cacheKey])
  @@map("shots")
}

model DialogueLine {
  id          String  @id @default(uuid()) @db.Uuid
  sceneId     String  @map("scene_id") @db.Uuid
  scene       Scene   @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  index       Int
  characterId String? @map("character_id") @db.Uuid
  text        String
  emotion     String?
  audioKey    String? @map("audio_key")
  startMs     Int?    @map("start_ms")

  @@index([sceneId])
  @@map("dialogue_lines")
}

enum AudioKind {
  VOICE
  MUSIC
  SFX
  AMBIENCE

  @@map("audio_kind")
}

model AudioTrack {
  id         String    @id @default(uuid()) @db.Uuid
  sceneId    String    @map("scene_id") @db.Uuid
  scene      Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  kind       AudioKind
  key        String
  startMs    Int       @default(0) @map("start_ms")
  durationMs Int?      @map("duration_ms")
  gainDb     Float     @default(0) @map("gain_db")
  meta       Json?

  @@index([sceneId, kind])
  @@map("audio_tracks")
}

// ─────────────────────────────────────────────────────────────
// Continuity Engine
// ─────────────────────────────────────────────────────────────

model ContinuityState {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneIndex Int      @map("scene_index")
  state      Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([projectId, sceneIndex])
  @@index([projectId])
  @@map("continuity_states")
}

// ─────────────────────────────────────────────────────────────
// Film & rendering
// ─────────────────────────────────────────────────────────────

enum RenderStatus {
  QUEUED
  ASSEMBLING
  TRANSCODING
  DONE
  FAILED

  @@map("render_status")
}

model RenderJob {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @map("project_id") @db.Uuid
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String       @default("final")
  status    RenderStatus @default(QUEUED)
  progress  Float        @default(0)
  outputKey String?      @map("output_key")
  log       String?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, status])
  @@map("render_jobs")
}

model Film {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @unique @map("project_id") @db.Uuid
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mp4Key       String    @map("mp4_key")
  hlsKey       String?   @map("hls_key")
  posterKey    String?   @map("poster_key")
  durationSec  Float     @map("duration_sec")
  subtitleKey  String?   @map("subtitle_key")
  sizeBytes    BigInt?   @map("size_bytes")
  version      Int       @default(1)
  views        Int       @default(0)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(6)
  publications Json?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("films")
}

// ─────────────────────────────────────────────────────────────
// Usage / quotas
// ─────────────────────────────────────────────────────────────

model UsageRecord {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?  @map("project_id") @db.Uuid
  gpuMs     Int      @default(0) @map("gpu_ms")
  kind      String
  costUsd   Float    @default(0) @map("cost_usd")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("usage_records")
}
