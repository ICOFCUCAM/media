// Cineforge — Prisma schema
// PostgreSQL. Mapped onto the Supabase database (snake_case tables/columns,
// uuid ids, Postgres enum types) so the worker/API read & write the SAME tables
// the web app uses via Supabase. See docs/02-database-schema.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Identity & billing
// ─────────────────────────────────────────────────────────────

enum Tier {
  FREE
  CREATOR
  STUDIO
  AGENCY
  ENTERPRISE

  @@map("tier")
}

enum Role {
  USER
  ADMIN

  @@map("role")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  displayName String?  @map("display_name")
  role        Role     @default(USER)
  tier        Tier     @default(FREE)
  creditsMs   Int      @default(0) @map("credits_ms") // remaining generation budget, in GPU-ms
  stripeId    String?  @map("stripe_id")
  notifyOnFinish Boolean @default(false) @map("notify_on_finish") // email when a production is READY/FAILED
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  projects Project[]
  apiKeys  ApiKey[]
  usage    UsageRecord[]

  @@map("users")
}

model ApiKey {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashed    String    @unique
  label     String?
  lastUsed  DateTime? @map("last_used") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────
// Project / film
// ─────────────────────────────────────────────────────────────

enum ProjectStatus {
  DRAFT
  PLANNING
  GENERATING
  RENDERING
  PAUSED
  READY
  FAILED

  @@map("project_status")
}

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  prompt        String
  targetSeconds Int           @map("target_seconds")
  /// Output format chosen at create time ("480p"|"720p"|"1080p"|"4k") — docs/33.
  resolution    String   @default("720p")
  aspectRatio   String        @default("16:9") @map("aspect_ratio")
  modelId       String        @default("wan-2.1") @map("model_id")
  status        ProjectStatus @default(DRAFT)
  mode          String        @default("auto") // auto | hybrid | storyboard | script | library …
  progress      Float         @default(0)
  estimatedMs   Int?          @map("estimated_ms")
  spentMs       Int           @default(0) @map("spent_ms")
  errorMessage  String?       @map("error_message")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  screenplay  Screenplay?
  characters  Character[]
  locations   Location[]
  objects     WorldObject[]
  scenes      Scene[]
  continuity  ContinuityState[]
  film        Film?
  renderJobs  RenderJob[]
  series      Series?
  storyEvents StoryEvent[]

  @@index([userId, status])
  @@map("projects")
}

// ─────────────────────────────────────────────────────────────
// Phase 3 — Episodic hierarchy
// ─────────────────────────────────────────────────────────────

model Series {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  synopsis  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  seasons Season[]

  @@map("series")
}

model Season {
  id        String   @id @default(uuid()) @db.Uuid
  seriesId  String   @map("series_id") @db.Uuid
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  number    Int
  title     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  episodes Episode[]

  @@unique([seriesId, number])
  @@map("seasons")
}

model Episode {
  id        String   @id @default(uuid()) @db.Uuid
  seasonId  String   @map("season_id") @db.Uuid
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  synopsis  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  scenes Scene[]

  @@unique([seasonId, number])
  @@map("episodes")
}

model StoryEvent {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  episodeIndex Int?     @map("episode_index")
  sceneIndex   Int?     @map("scene_index")
  kind         String
  summary      String
  payload      Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, episodeIndex, sceneIndex])
  @@map("story_events")
}

// ─────────────────────────────────────────────────────────────
// Screenplay (Director AI output)
// ─────────────────────────────────────────────────────────────

model Screenplay {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @unique @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logline   String
  synopsis  String
  genre     String?
  tone      String?
  acts      Json
  raw       Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("screenplays")
}

// ─────────────────────────────────────────────────────────────
// Character Bible
// ─────────────────────────────────────────────────────────────

model Character {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  age           Int?
  gender        String?
  ethnicity     String?
  appearance    String
  personality   String?
  voiceProfile  Json?    @map("voice_profile")
  arc           String?
  referenceUrls String[] @map("reference_urls")
  loraKey       String?  @map("lora_key")
  loraVersion   String?  @map("lora_version")
  /// Content hash of the LoRA artifact (migration 0027; authz v2). Server-written only.
  loraSha256    String?  @map("lora_sha256")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  wardrobes     Wardrobe[]
  relationships Relationship[]   @relation("fromChar")
  related       Relationship[]   @relation("toChar")
  sceneRoles    SceneCharacter[]

  @@index([projectId])
  @@map("characters")
}

model Wardrobe {
  id             String    @id @default(uuid()) @db.Uuid
  characterId    String    @map("character_id") @db.Uuid
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  label          String
  description    String
  validFromScene Int?      @map("valid_from_scene")
  validToScene   Int?      @map("valid_to_scene")

  @@index([characterId])
  @@map("wardrobes")
}

model Relationship {
  id     String    @id @default(uuid()) @db.Uuid
  fromId String    @map("from_id") @db.Uuid
  toId   String    @map("to_id") @db.Uuid
  from   Character @relation("fromChar", fields: [fromId], references: [id], onDelete: Cascade)
  to     Character @relation("toChar", fields: [toId], references: [id], onDelete: Cascade)
  kind   String

  @@unique([fromId, toId, kind])
  @@map("relationships")
}

// ─────────────────────────────────────────────────────────────
// World Bible
// ─────────────────────────────────────────────────────────────

enum LocationKind {
  CITY
  KINGDOM
  BUILDING
  ROOM
  LANDSCAPE
  INTERIOR
  EXTERIOR

  @@map("location_kind")
}

model Location {
  id            String       @id @default(uuid()) @db.Uuid
  projectId     String       @map("project_id") @db.Uuid
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  kind          LocationKind
  description   String
  parentId      String?      @map("parent_id") @db.Uuid
  parent        Location?    @relation("loc", fields: [parentId], references: [id])
  children      Location[]   @relation("loc")
  referenceUrls String[]     @map("reference_urls")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  scenes Scene[]

  @@index([projectId])
  @@map("locations")
}

model WorldObject {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  description   String
  referenceUrls String[] @map("reference_urls")
  category      String   @default("object")

  @@index([projectId])
  @@map("world_objects")
}

// ─────────────────────────────────────────────────────────────
// Scenes & shots
// ─────────────────────────────────────────────────────────────

enum SceneStatus {
  PENDING
  PROMPTING
  GENERATING
  AUDIO
  QC
  READY
  FAILED

  @@map("scene_status")
}

model Scene {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  index       Int
  locationId  String?     @map("location_id") @db.Uuid
  location    Location?   @relation(fields: [locationId], references: [id])
  heading     String
  summary     String
  episodeId   String?     @map("episode_id") @db.Uuid
  episode     Episode?    @relation(fields: [episodeId], references: [id])
  timeOfDay   String?     @map("time_of_day")
  weather     String?
  status      SceneStatus @default(PENDING)
  durationSec Float       @default(0) @map("duration_sec")

  // Continuity Engine (docs/28)
  dialogue        String?
  narration       String?
  camera          String?
  mood            String?
  music           String?
  characterRef    String? @map("character_ref")
  worldRef        String? @map("world_ref")
  locationNote    String? @map("location_note")
  bridge          Json?
  statePatch      Json?   @map("state_patch")
  subtitles       Json?
  dependsOn       Int[]   @default([]) @map("depends_on")
  continuityScore Int?    @map("continuity_score")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  shots       Shot[]
  characters  SceneCharacter[]
  dialogueLines DialogueLine[]
  audioTracks AudioTrack[]

  @@unique([projectId, index])
  @@index([projectId, status])
  @@map("scenes")
}

model SceneCharacter {
  id          String    @id @default(uuid()) @db.Uuid
  sceneId     String    @map("scene_id") @db.Uuid
  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  wardrobeId  String?   @map("wardrobe_id") @db.Uuid

  @@unique([sceneId, characterId])
  @@map("scene_characters")
}

enum ShotStatus {
  PENDING
  QUEUED
  GENERATING
  UPLOADED
  QC_PASS
  QC_FAIL
  READY
  FAILED

  @@map("shot_status")
}

model Shot {
  id                String     @id @default(uuid()) @db.Uuid
  sceneId           String     @map("scene_id") @db.Uuid
  scene             Scene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  index             Int
  prompt            String
  negativePrompt    String?    @map("negative_prompt")
  source            String     @default("text")
  seedImageKey      String?    @map("seed_image_key")
  referenceVideoKey String?    @map("reference_video_key")
  cameraType        String?    @map("camera_type")
  cameraMovement    String?    @map("camera_movement")
  cameraPlan        Json?      @map("camera_plan")
  seed              BigInt?
  durationSec       Float      @default(5) @map("duration_sec")
  modelId           String     @default("wan-2.1") @map("model_id")
  modelVersion      String?    @map("model_version")
  promptHash        String?    @map("prompt_hash")
  cacheKey          String?    @map("cache_key")
  status            ShotStatus @default(PENDING)
  videoKey          String?    @map("video_key")
  thumbnailKey      String?    @map("thumbnail_key")
  qcScore           Float?     @map("qc_score")
  gpuMs             Int?       @map("gpu_ms")
  attempts          Int        @default(0)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([sceneId, index])
  @@index([status])
  @@index([cacheKey])
  @@map("shots")
}

model DialogueLine {
  id          String  @id @default(uuid()) @db.Uuid
  sceneId     String  @map("scene_id") @db.Uuid
  scene       Scene   @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  index       Int
  characterId String? @map("character_id") @db.Uuid
  text        String
  emotion     String?
  audioKey    String? @map("audio_key")
  startMs     Int?    @map("start_ms")

  @@index([sceneId])
  @@map("dialogue_lines")
}

enum AudioKind {
  VOICE
  MUSIC
  SFX
  AMBIENCE

  @@map("audio_kind")
}

model AudioTrack {
  id         String    @id @default(uuid()) @db.Uuid
  sceneId    String    @map("scene_id") @db.Uuid
  scene      Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  kind       AudioKind
  key        String
  startMs    Int       @default(0) @map("start_ms")
  durationMs Int?      @map("duration_ms")
  gainDb     Float     @default(0) @map("gain_db")
  meta       Json?

  @@index([sceneId, kind])
  @@map("audio_tracks")
}

// ─────────────────────────────────────────────────────────────
// Continuity Engine
// ─────────────────────────────────────────────────────────────

model ContinuityState {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneIndex Int      @map("scene_index")
  state      Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([projectId, sceneIndex])
  @@index([projectId])
  @@map("continuity_states")
}

// ─────────────────────────────────────────────────────────────
// Film & rendering
// ─────────────────────────────────────────────────────────────

enum RenderStatus {
  QUEUED
  ASSEMBLING
  TRANSCODING
  DONE
  FAILED

  @@map("render_status")
}

model RenderJob {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @map("project_id") @db.Uuid
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String       @default("final")
  status    RenderStatus @default(QUEUED)
  progress  Float        @default(0)
  outputKey String?      @map("output_key")
  log       String?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId, status])
  @@map("render_jobs")
}

model Film {
  id           String    @id @default(uuid()) @db.Uuid
  projectId    String    @unique @map("project_id") @db.Uuid
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mp4Key       String    @map("mp4_key")
  hlsKey       String?   @map("hls_key")
  posterKey    String?   @map("poster_key")
  durationSec  Float     @map("duration_sec")
  subtitleKey  String?   @map("subtitle_key")
  sizeBytes    BigInt?   @map("size_bytes")
  version      Int       @default(1)
  views        Int       @default(0)
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(6)
  publications Json?
  // Per-language variants (docs/29 dubbing): locales[lang] = { mp4, voice, subtitle }
  locales      Json?
  /// 4K upscaled master (Studio+; fal upscaler) — docs/33.
  mp44kKey     String?   @map("mp4_4k_key")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("films")
}

// ─────────────────────────────────────────────────────────────
// Usage / quotas
// ─────────────────────────────────────────────────────────────

model UsageRecord {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?  @map("project_id") @db.Uuid
  gpuMs     Int      @default(0) @map("gpu_ms")
  kind      String
  costUsd   Float    @default(0) @map("cost_usd")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@map("usage_records")
}

// ── Voice Lab (docs/29 phase 2): cloned voices + long-form voiceovers ──────
model Voice {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  name            String
  sampleKey       String?     @map("sample_key")
  provider        String?
  providerVoiceId String?     @map("provider_voice_id")
  status          String      @default("PENDING")
  shareStatus     String      @default("PRIVATE") @map("share_status")
  shareTerms      String?     @map("share_terms")
  errorMessage    String?     @map("error_message")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  voiceovers      Voiceover[]

  @@map("voices")
}

model Voiceover {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  voiceId      String?  @map("voice_id") @db.Uuid
  voice        Voice?   @relation(fields: [voiceId], references: [id], onDelete: SetNull)
  title        String
  text         String
  language     String   @default("en")
  audioKey     String?  @map("audio_key")
  status       String   @default("PENDING")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("voiceovers")
}

// ── Social Launchpad (docs/31): upload video -> AI kit -> one-button publish ─
model SocialLaunch {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  videoKey     String   @map("video_key")
  brief        String   @default("")
  status       String   @default("PENDING")
  kit          Json?
  results      Json?
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("social_launches")
}

// ── Phase 3 (docs/29): talking-avatar videos (photo + voiceover -> video) ──
model AvatarVideo {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  voiceoverId  String?  @map("voiceover_id") @db.Uuid
  title        String   @default("")
  imageKey     String   @map("image_key")
  quality      String   @default("standard")
  status       String   @default("PENDING")
  videoKey     String?  @map("video_key")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("avatar_videos")
}

// ── Brand kits (docs/33 AGENCY+): applied as a branded outro at render ──────
model BrandKit {
  userId         String   @id @map("user_id") @db.Uuid
  logoKey        String?  @map("logo_key")
  primaryColor   String   @default("#6366f1") @map("primary_color")
  secondaryColor String   @default("#d946ef") @map("secondary_color")
  outroText      String?  @map("outro_text")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("brand_kits")
}

/// Interest in marketplace catalogues that are not open yet (migration 0012).
model MarketplaceWaitlist {
  userId    String   @map("user_id") @db.Uuid
  catalogue String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([userId, catalogue])
  @@map("marketplace_waitlist")
}

// ── Media Runtime Gateway (docs/39; migration 0026) ─────────────────────────
// Registry of GPU deployments and the execution audit trail. Written only by
// the worker; admins read. Grant identity columns and events are immutable
// (database triggers).

model RuntimeDeployment {
  id            String   @id
  modelId       String   @map("model_id")
  baseUrl       String   @unique @map("base_url")
  runpodPodId   String?  @map("runpod_pod_id")
  status        String   @default("pending")
  enforcement   String   @default("report")
  manifest      Json?
  approvedImage String?  @map("approved_image")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  grants RuntimeExecutionGrant[]

  @@map("runtime_deployments")
}

model RuntimeExecutionGrant {
  id           String             @id
  jti          String?            @unique
  deploymentId String?            @map("deployment_id")
  deployment   RuntimeDeployment? @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  shotId       String?            @map("shot_id") @db.Uuid
  projectId    String?            @map("project_id") @db.Uuid
  scope        String
  mode         String
  authzDigest  String?            @map("authz_digest")
  bodySha256   String?            @map("body_sha256")
  inputKeys    String[]           @default([]) @map("input_keys")
  outputKeys   String[]           @default([]) @map("output_keys")
  imageRef     String?            @map("image_ref")
  issuedAt     DateTime           @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt    DateTime?          @map("expires_at") @db.Timestamptz(6)
  outcome      String
  errorCode    String?            @map("error_code")
  gpuMs        Int?               @map("gpu_ms")
  outputBytes  BigInt?            @map("output_bytes")
  completedAt  DateTime?          @map("completed_at") @db.Timestamptz(6)

  @@index([shotId], map: "runtime_execution_grants_shot_idx")
  @@index([deploymentId, issuedAt(sort: Desc)], map: "runtime_execution_grants_deployment_idx")
  @@map("runtime_execution_grants")
}

model RuntimeGatewayEvent {
  id           String   @id @default(uuid()) @db.Uuid
  type         String
  deploymentId String?  @map("deployment_id")
  grantId      String?  @map("grant_id")
  code         String?
  detail       Json     @default("{}")
  actor        String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([deploymentId, createdAt(sort: Desc)], map: "runtime_gateway_events_deployment_idx")
  @@map("runtime_gateway_events")
}

// ─────────────────────────────────────────────────────────────
// Master Production Clock, generation ledgers and A/V sync
// (migrations 0028–0030; docs/38 §AU.16, §AV.5, §AW.9). Times are
// integer microseconds (BigInt); rates are fpsNum/fpsDen. Scalar foreign
// keys only: the database enforces the relations, immutability and RLS.
// ─────────────────────────────────────────────────────────────

model ProductionTimeline {
  id                String    @id @default(uuid()) @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  version           Int
  parentVersionId   String?   @map("parent_version_id") @db.Uuid
  fpsNum            Int       @map("fps_num")
  fpsDen            Int       @map("fps_den")
  sampleRate        Int       @default(48000) @map("sample_rate")
  durationUs        BigInt    @default(0) @map("duration_us")
  status            String    @default("draft")
  syncPolicyId      String    @default("cinematic") @map("sync_policy_id")
  syncPolicyVersion Int       @default(1) @map("sync_policy_version")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz(6)

  @@unique([projectId, version])
  @@index([projectId, version(sort: Desc)], map: "production_timelines_project_idx")
  @@map("production_timelines")
}

model TimelineEvent {
  id                String   @id @default(uuid()) @db.Uuid
  timelineVersionId String   @map("timeline_version_id") @db.Uuid
  kind              String
  startUs           BigInt   @map("start_us")
  endUs             BigInt   @map("end_us")
  refType           String?  @map("ref_type")
  refId             String?  @map("ref_id") @db.Uuid
  parentEventId     String?  @map("parent_event_id") @db.Uuid
  anchorEventId     String?  @map("anchor_event_id") @db.Uuid
  anchorOffsetUs    BigInt?  @map("anchor_offset_us")
  anchorMode        String?  @map("anchor_mode")
  payload           Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([timelineVersionId, startUs], map: "timeline_events_timeline_idx")
  @@index([refType, refId], map: "timeline_events_ref_idx")
  @@map("timeline_events")
}

model MediaVersion {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  assetType     String   @map("asset_type")
  assetId       String   @map("asset_id") @db.Uuid
  version       Int
  storageKey    String   @map("storage_key")
  sha256        String?
  durationUs    BigInt?  @map("duration_us")
  derivedFrom   String[] @default([]) @map("derived_from") @db.Uuid
  derivation    Json?
  generationRef String?  @map("generation_ref")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([assetType, assetId, version])
  @@index([projectId, assetType], map: "media_versions_project_idx")
  @@map("media_versions")
}

model VideoGeneration {
  id                  String    @id @default(uuid()) @db.Uuid
  projectId           String    @map("project_id") @db.Uuid
  shotId              String?   @map("shot_id") @db.Uuid
  timelineVersionId   String?   @map("timeline_version_id") @db.Uuid
  attempt             Int       @default(1)
  modelId             String    @map("model_id")
  modelVersion        String?   @map("model_version")
  runtime             String    @default("diffusers")
  runtimeVersion      String?   @map("runtime_version")
  workflowId          String    @default("cineforge.video-shot") @map("workflow_id")
  workflowVersion     Int       @default(1) @map("workflow_version")
  graphSha256         String?   @map("graph_sha256")
  grantId             String?   @map("grant_id")
  requestedDurationUs BigInt    @map("requested_duration_us")
  requestedFpsNum     Int       @map("requested_fps_num")
  requestedFpsDen     Int       @default(1) @map("requested_fps_den")
  timingConstraints   Json      @default("{}") @map("timing_constraints")
  timingReport        Json?     @map("timing_report")
  actualDurationUs    BigInt?   @map("actual_duration_us")
  outcome             String?
  outcomeCode         String?   @map("outcome_code")
  policy              String?
  decision            Json?
  mediaVersionId      String?   @map("media_version_id") @db.Uuid
  gpuMs               Int?      @map("gpu_ms")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  classifiedAt        DateTime? @map("classified_at") @db.Timestamptz(6)

  @@index([shotId, createdAt(sort: Desc)], map: "video_generations_shot_idx")
  @@index([projectId, outcome], map: "video_generations_outcome_idx")
  @@map("video_generations")
}

model AudioGeneration {
  id               String    @id @default(uuid()) @db.Uuid
  projectId        String    @map("project_id") @db.Uuid
  kind             String
  dialogueLineId   String?   @map("dialogue_line_id") @db.Uuid
  language         String?
  voiceId          String?   @map("voice_id")
  provider         String
  modelId          String?   @map("model_id")
  attempt          Int       @default(1)
  requestedStartUs BigInt?   @map("requested_start_us")
  requestedEndUs   BigInt?   @map("requested_end_us")
  meta             Json      @default("{}")
  timingReport     Json?     @map("timing_report")
  outcome          String?
  outcomeCode      String?   @map("outcome_code")
  policy           String?
  mediaVersionId   String?   @map("media_version_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  classifiedAt     DateTime? @map("classified_at") @db.Timestamptz(6)

  @@index([projectId, kind], map: "audio_generations_project_idx")
  @@map("audio_generations")
}

model AudioEvent {
  id                String   @id @default(uuid()) @db.Uuid
  timelineVersionId String   @map("timeline_version_id") @db.Uuid
  timelineEventId   String?  @map("timeline_event_id") @db.Uuid
  audioGenerationId String?  @map("audio_generation_id") @db.Uuid
  mediaVersionId    String?  @map("media_version_id") @db.Uuid
  stem              String
  startUs           BigInt   @map("start_us")
  endUs             BigInt   @map("end_us")
  gainDb            Decimal  @default(0) @map("gain_db") @db.Decimal(6, 2)
  fadeInUs          BigInt   @default(0) @map("fade_in_us")
  fadeOutUs         BigInt   @default(0) @map("fade_out_us")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([timelineVersionId, stem, startUs], map: "audio_events_timeline_idx")
  @@map("audio_events")
}

model SyncPolicyRow {
  id         String
  version    Int
  tolerances Json
  repair     Json
  delivery   Json
  calibrated Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([id, version])
  @@map("sync_policies")
}

model AvSyncReport {
  id                String   @id @default(uuid()) @db.Uuid
  timelineVersionId String   @map("timeline_version_id") @db.Uuid
  scope             Json     @default("{}")
  checks            String[]
  passed            Boolean
  policy            String
  toolVersions      Json     @default("{}") @map("tool_versions")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([timelineVersionId, createdAt(sort: Desc)], map: "av_sync_reports_timeline_idx")
  @@map("av_sync_reports")
}

model AvSyncIssue {
  id           String    @id @default(uuid()) @db.Uuid
  reportId     String    @map("report_id") @db.Uuid
  check        String
  severity     String
  sceneId      String?   @map("scene_id") @db.Uuid
  shotId       String?   @map("shot_id") @db.Uuid
  eventId      String?   @map("event_id") @db.Uuid
  atUs         BigInt    @map("at_us")
  spanUs       BigInt?   @map("span_us")
  measured     Json      @default("{}")
  expected     Json      @default("{}")
  confidence   Decimal   @db.Decimal(4, 3)
  message      String
  status       String    @default("open")
  waiverReason String?   @map("waiver_reason")
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)

  @@index([reportId, severity], map: "av_sync_issues_report_idx")
  @@map("av_sync_issues")
}

model RepairJob {
  id                   String    @id @default(uuid()) @db.Uuid
  issueId              String    @map("issue_id") @db.Uuid
  action               Json
  status               String    @default("planned")
  attempt              Int       @default(1)
  resultMediaVersionId String?   @map("result_media_version_id") @db.Uuid
  error                String?
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt           DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([issueId, attempt], map: "repair_jobs_issue_idx")
  @@map("repair_jobs")
}

// ─────────────────────────────────────────────────────────────
// Truth layer (migration 0031; DirectorOS W1 — DOS-73/75/77/78)
// ─────────────────────────────────────────────────────────────

/// A gap a production ran with (append-only). Failures stop the job instead.
model ProductionDegradation {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  code      String
  severity  String
  scope     String
  refId     String?  @map("ref_id")
  message   String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, createdAt], map: "production_degradations_project_idx")
  @@map("production_degradations")
}

/// What is actually operational now, computed by the worker (never hand-written).
model SystemCapability {
  capability    String   @id
  provider      String?
  status        String
  realExecution Boolean  @map("real_execution")
  requiresGpu   Boolean  @default(false) @map("requires_gpu")
  supports      String[] @default([])
  note          String?
  reportedBy    String   @map("reported_by")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("system_capabilities")
}

/// One call to a reasoning model (migration 0032; DOS-48/49). Append-only.
model AiDecision {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String?  @map("project_id") @db.Uuid
  task          String
  promptId      String   @map("prompt_id")
  promptVersion Int      @map("prompt_version")
  schemaName    String   @map("schema_name")
  provider      String?
  model         String?
  attempt       Int      @default(0)
  inputSha256   String   @map("input_sha256")
  outputSha256  String?  @map("output_sha256")
  outcome       String
  errorCode     String?  @map("error_code")
  issues        Int      @default(0)
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  latencyMs     Int?     @map("latency_ms")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, createdAt], map: "ai_decisions_project_idx")
  @@index([task, createdAt], map: "ai_decisions_task_idx")
  @@map("ai_decisions")
}

/// Canon revisions (DirectorOS W3, migration 0033): append-only log of canon
/// changes after planning and exactly which scenes/shots each one touched.
model CanonRevision {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  kind           String
  change         Json
  fromVersion    String   @map("from_version")
  toVersion      String   @map("to_version")
  outcome        String
  issues         Json     @default("[]")
  affectedScenes String[] @default([]) @map("affected_scenes")
  affectedShots  Json     @default("[]") @map("affected_shots")
  invalidated    Int      @default(0)
  actor          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId, createdAt], map: "canon_revisions_project_idx")
  @@map("canon_revisions")
}

/// Wardrobe reference pack (migration 0034): one still per character,
/// wardrobe entry and canon digest; append-only.
model WardrobeReference {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  characterId String   @map("character_id") @db.Uuid
  wardrobeKey String   @map("wardrobe_key")
  digest      String
  storageKey  String   @map("storage_key")
  provider    String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([characterId, wardrobeKey, digest])
  @@index([projectId], map: "wardrobe_references_project_idx")
  @@map("wardrobe_references")
}
