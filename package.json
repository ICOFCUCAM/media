{
  "name": "cineforge",
  "private": true,
  "version": "0.0.0",
  "description": "AI Film Generation Platform — long-form films from a prompt using Wan 2.1 / Hunyuan on RunPod.",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @cineforge/db prisma migrate dev",
    "db:generate": "pnpm --filter @cineforge/db prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.11.0"
  },
  "engines": {
    "node": ">=20"
  }
}
