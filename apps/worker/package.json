{
  "name": "@cineforge/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "gateway:admin": "tsx src/gateway/admin-cli.ts",
    "timeline:build": "tsx src/timeline/cli.ts",
    "avsync:check": "tsx src/avsync/cli.ts",
    "canon:revise": "tsx src/canon/cli.ts",
    "canon:live-check": "tsx src/canon/live-check.ts",
    "providers:live": "tsx src/acceptance/providers-cli.ts",
    "bench:live": "tsx src/bench/cli.ts live",
    "bench:record": "tsx src/bench/cli.ts offline",
    "sync:calibrate": "tsx src/bench/cli.ts calibrate",
    "film:accept": "tsx src/acceptance/film-cli.ts",
    "voice:bench": "tsx src/bench/voice-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.580.0",
    "@aws-sdk/s3-request-presigner": "^3.580.0",
    "@cineforge/bench": "workspace:*",
    "@cineforge/db": "workspace:*",
    "@cineforge/gpu": "workspace:*",
    "@cineforge/model-adapters": "workspace:*",
    "@cineforge/movie": "workspace:*",
    "@cineforge/shared": "workspace:*",
    "@cineforge/voice-contracts": "workspace:*",
    "bullmq": "^5.7.0",
    "ioredis": "^5.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsx": "^4.10.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
