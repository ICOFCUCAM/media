  "workflows": [
    {
      "id": "cineforge.still.t2i",
      "version": 1,
      "file": "cineforge.still.t2i@1.json",
      "purpose": "text_to_image",
      "modelLabel": "qwen-image",
      "models": {
        "diffusion": "qwen-image.diffusion",
        "text_encoder": "qwen2.5-vl-7b.text-encoder",
        "vae": "qwen-image.vae"
      },
      "output": "11",
      "slots": {
        "prompt": {"type": "string", "required": true, "maxLength": 4000, "targets": [["6", "text"]]},
        "negative": {"type": "string", "default": "", "maxLength": 2000, "targets": [["7", "text"]]},
        "seed": {"type": "int", "required": true, "min": 0, "max": 2147483647, "targets": [["9", "seed"]]},
        "width": {"type": "int", "required": true, "min": 256, "max": 2048, "multipleOf": 16, "targets": [["8", "width"]]},
        "height": {"type": "int", "required": true, "min": 256, "max": 2048, "multipleOf": 16, "targets": [["8", "height"]]},
        "steps": {"type": "int", "default": 20, "min": 4, "max": 50, "targets": [["9", "steps"]]},
        "lora": {"type": "lora", "node": "4", "bypassInput": "model", "defaultScale": 1.0, "minScale": 0.0, "maxScale": 2.0}
      },
      "limits": {"maxMegapixels": 2.1, "timeoutSec": 600}
    },
    {
      "id": "cineforge.still.ref",
      "version": 1,
      "file": "cineforge.still.ref@1.json",
      "purpose": "reference_to_image",
      "modelLabel": "qwen-image-edit-2511",
      "models": {
        "diffusion": "qwen-image-edit-2511.diffusion",
        "text_encoder": "qwen2.5-vl-7b.text-encoder",
        "vae": "qwen-image.vae"
      },
      "output": "11",
      "slots": {
        "prompt": {"type": "string", "required": true, "maxLength": 4000, "targets": [["12", "prompt"]]},
        "negative": {"type": "string", "default": "", "maxLength": 2000, "targets": [["13", "prompt"]]},
        "seed": {"type": "int", "required": true, "min": 0, "max": 2147483647, "targets": [["9", "seed"]]},
        "width": {"type": "int", "required": true, "min": 256, "max": 2048, "multipleOf": 16, "targets": [["8", "width"]]},
        "height": {"type": "int", "required": true, "min": 256, "max": 2048, "multipleOf": 16, "targets": [["8", "height"]]},
        "steps": {"type": "int", "default": 20, "min": 4, "max": 50, "targets": [["9", "steps"]]},
        "references": {
          "type": "images",
          "min": 1,
          "targets": [
            {"node": "20", "consumers": [["12", "image1"], ["13", "image1"]]},
            {"node": "21", "consumers": [["12", "image2"], ["13", "image2"]]},
            {"node": "22", "consumers": [["12", "image3"], ["13", "image3"]]}
          ]
        },
        "lora": {"type": "lora", "node": "4", "bypassInput": "model", "defaultScale": 1.0, "minScale": 0.0, "maxScale": 2.0}
      },
      "limits": {"maxMegapixels": 2.1, "timeoutSec": 900}
    }
  ]
}
